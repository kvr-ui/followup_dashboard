PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/followup_dashboard

# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Initial admin account, created on first startup if no admin exists.
ADMIN_NAME=Venkat Ramanan Kalyanaraman
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=kvr@focasedu.com

# --- WhatsApp / WATI ---------------------------------------------------------
WATI_API_URL=https://live-mt-server.wati.io/xxxxx
WATI_TOKEN=

# Zoho CRM write-back (optional). Without these, status/note changes are saved
# locally only. Fill in to sync changes back to Zoho.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# ZOHO_API_URL=https://www.zohoapis.in
# ZOHO_MODULE=Tasks

# --- Meta Ads sync ------------------------------------------------------------
# Meta Marketing API access token used to pull ad/campaign/lead data.
META_ACCESS_TOKEN=
# The Meta ad account to sync (numeric account ID, no "act_" prefix needed
# unless the connector expects it).
META_AD_ACCOUNT_ID=
# Graph API version to call, e.g. v24.0.
META_API_VERSION=v24.0
# How often to run the ad sync, in minutes. 1440 = once a day. Leave unset to
# disable the scheduler entirely (sync can still be triggered manually).
SYNC_INTERVAL_MINUTES=1440
# Meta exposes leads per LEAD FORM, not per ad account, so the forms have to be
# named. Set either one — the explicit ids are cheapest, the Page id discovers
# every form on it. With neither, the leads stage is skipped with a log line and
# the rest of the sync still runs.
META_LEAD_FORM_IDS=
META_PAGE_ID=
# How far back a scheduled sync pulls insights. Meta's own numbers keep moving
# for a day or two after the fact, so the window is a re-pull, not a backfill.
AD_INSIGHT_LOOKBACK_DAYS=30
# How long after boot the first sync runs, in ms. Long enough that a cold start
# isn't competing with a slow Meta pull; short enough that a fresh deploy isn't
# showing day-old numbers until the first interval elapses.
AD_SYNC_FIRST_RUN_DELAY_MS=120000

# --- Public lead ingest ---------------------------------------------------------
# Comma-separated list of origins allowed to POST to the public lead ingest
# endpoint, e.g. https://focasedu.com,https://www.focasedu.com.
CORS_ORIGINS=
# Per-IP rate limit (requests per minute) on the public lead ingest endpoint.
WEB_LEAD_RATE_MAX=60
# Shared secret required on server-to-server lead posts (e.g. from the
# marketing site or a forwarding service), sent in the `X-Lead-Ingest-Token`
# header. Requests without a matching token are rejected. Leave unset to skip
# the check (local development and the cutover window only) — the server logs a
# warning at boot when it is unset.
LEAD_INGEST_TOKEN=
