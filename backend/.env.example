PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/followup_dashboard

# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Initial admin account, created on first startup if no admin exists.
ADMIN_NAME=Venkat Ramanan Kalyanaraman
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=kvr@focasedu.com

# --- WhatsApp / WATI ---------------------------------------------------------
WATI_API_URL=https://live-mt-server.wati.io/xxxxx
WATI_TOKEN=

# Zoho CRM write-back (optional). Without these, status/note changes are saved
# locally only. Fill in to sync changes back to Zoho.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# ZOHO_API_URL=https://www.zohoapis.in
# ZOHO_MODULE=Tasks

# --- Meta Ads sync ------------------------------------------------------------
# Meta Marketing API access token used to pull ad/campaign/lead data.
META_ACCESS_TOKEN=
# The Meta ad account to sync (numeric account ID, no "act_" prefix needed
# unless the connector expects it).
META_AD_ACCOUNT_ID=
# Graph API version to call, e.g. v24.0.
META_API_VERSION=v24.0
# How often to run the ad sync, in minutes. 1440 = once a day. Leave unset to
# disable the scheduler entirely (sync can still be triggered manually).
SYNC_INTERVAL_MINUTES=1440
# Meta exposes leads per LEAD FORM, not per ad account, so the forms have to be
# named. Set either one — the explicit ids are cheapest, the Page id discovers
# every form on it. With neither, the leads stage is skipped with a log line and
# the rest of the sync still runs.
META_LEAD_FORM_IDS=
META_PAGE_ID=
# How far back a scheduled sync pulls insights. Meta's own numbers keep moving
# for a day or two after the fact, so the window is a re-pull, not a backfill.
AD_INSIGHT_LOOKBACK_DAYS=30
# How long after boot the first sync runs, in ms. Long enough that a cold start
# isn't competing with a slow Meta pull; short enough that a fresh deploy isn't
# showing day-old numbers until the first interval elapses.
AD_SYNC_FIRST_RUN_DELAY_MS=120000

# --- Public lead ingest -------------------------------------------------------
# As of task 13 (see plans/crm-integration/CUTOVER.md), this service is the
# ONLY place the Focas landing pages' captured leads land — focas-crm is
# retired. Both values below are load-bearing in production, not optional.
#
# Comma-separated list of origins allowed to POST to the public lead ingest
# endpoint. This must name the real landing-page origin, not a placeholder —
# the CRM's own production config (focas-crm/.env, `CORS_ORIGINS`) used exactly
# https://focasedu.com, which is the value to carry over here.
CORS_ORIGINS=
# Per-IP rate limit (requests per minute) on the public lead ingest endpoint.
WEB_LEAD_RATE_MAX=60
# Shared secret required on server-to-server lead posts (e.g. from the
# marketing site or a forwarding service), sent in the `X-Lead-Ingest-Token`
# header. Requests without a matching token are rejected. Leave unset to skip
# the check (local development and the cutover window only) — the server logs a
# warning at boot when it is unset.
#
# The CRM never had an equivalent secret (CORS + rate limit only) — this is
# new hardening added for the cutover (see CUTOVER.md step 0). Generate a long
# random value, set it here AND as LEAD_INGEST_TOKEN (or equivalent) on the
# lead server that forwards captured leads, and restart both.
LEAD_INGEST_TOKEN=

# ── Call grading (Sarvam) ────────────────────────────────────────────────────
SARVAM_API_KEY=
# Grading model. sarvam-30b was deprecated server-side and now 400s on every request;
# 'sarvam-105b' is the current default. List what your account can reach with:
#   curl -H "Authorization: Bearer $SARVAM_API_KEY" https://api.sarvam.ai/v1/models
SARVAM_MODEL=sarvam-105b
# How many times ONE call may fail grading before the worker gives up on it. Only
# call-specific failures count — provider outages no longer burn this budget.
# GRADE_MAX_ATTEMPTS=3
# Sarvam publishes no balance endpoint, so the "AI Usage" tab can only show what is
# LEFT if you tell it what was bought. Set this to the token budget on the account and
# the Sarvam card shows remaining = allowance − tokens metered since this was deployed.
# Leave it unset and the card shows usage only.
# SARVAM_TOKEN_ALLOWANCE=

# ── Call transcription (ElevenLabs Scribe) ───────────────────────────────────
# The key needs the `speech_to_text` permission to transcribe, and ALSO `user_read`
# if you want the "AI Usage" tab to show the account's remaining character quota —
# without it ElevenLabs answers 401 missing_permissions and the balance reads
# "unavailable". Set both under ElevenLabs → Developers → API Keys.
ELEVENLABS_API_KEY=
# Scribe model. scribe_v2 is the default; the code falls back to scribe_v1 on a 422.
# ELEVENLABS_MODEL=scribe_v2

# ── What gets transcribed ────────────────────────────────────────────────────
# Which calls are worth paying to transcribe:
#   won    -> only calls on deals that closed with a sale  (cheapest)
#   closed -> won + lost                                    (enables comparison)
#   all    -> every recorded call                           (full coverage)
TRANSCRIBE_SCOPE=all
# Shortest call worth transcribing. 0 = every call that has a recording, however brief.
# NOTE: widening either of these two settings only affects calls ingested afterwards —
# calls already stored as `skipped` keep that verdict. The reconcile poll re-asks for
# calls still inside its window; for older history run:
#   node modules/calls/scripts/requeueSkipped.js --apply
TELECMI_MIN_DURATION_SEC=0

# ── Outbound calls ───────────────────────────────────────────────────────────
# TeleCMI's /v2/answered feed carries INBOUND DID traffic only — its direction filters
# are silently ignored and no other app-level endpoint exists. Outbound calls live behind
# a PER-AGENT API (/v2/user/out_cdr) authenticated with a login token, not appid/secret.
# This is the shared login password for the agent accounts in TELECMI_AGENTS (each logs
# in as "<ext>_<TELECMI_APP_ID>"). Without it, outbound calls — usually most of a rep's
# day — never reach the dashboard.
TELECMI_USER_PASSWORD=
#
# Those CDR rows include `filename`, so recordings download through /v2/play with the
# app credentials above. No Zoho PhoneBridge scope is needed.

# ── Bigin call ingest (secondary) ────────────────────────────────────────────
# Bigin mirrors every call and resolves contact names well, so it is polled as a
# cross-check and to get calls LISTED promptly. It never queues audio itself: Zoho's
# recording URLs need a PhoneBridge OAuth scope, so the audio always comes from TeleCMI
# and the outgoing poll flips these rows to `pending` once it attaches a filename.
# BIGIN_CALL_POLL_MINUTES=10
