# Auth for the private @santhosh785 scope (published to GitHub Packages,
# not npmjs.org). Needed to install @santhosh785/meta-ads.
#
# The token itself is never written here — npm substitutes it from the
# GITHUB_PACKAGES_TOKEN environment variable at install time. Locally, export
# GITHUB_PACKAGES_TOKEN (a GitHub personal access token with `read:packages`
# scope) before running npm install/ci. In Docker, it's supplied via a build
# secret (see docker-compose.yml).
@santhosh785:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_PACKAGES_TOKEN}
